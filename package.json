{
  "name": "quickstart-ai",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "QuickStart AI — multi-tenant AI agent platform (monorepo)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "integrity": "python3 scripts/check-repository-integrity.py",
    "check": "pnpm run integrity && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test",
    "seed:demo": "node --env-file=.env scripts/seed-demo-account.mjs",
    "stack:up": "bash scripts/start-local-stack.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
