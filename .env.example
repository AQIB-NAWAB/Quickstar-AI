# Local data plane (docker compose). Copy to .env and adjust if ports clash.
# Host port 5433 avoids clashing with a local/other Docker Postgres on 5432.
POSTGRES_PORT=5433
VALKEY_PORT=6379
KAFKA_PORT=9092
OPENSEARCH_PORT=9200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
SQS_PORT=9324
SQS_UI_PORT=9325

DATABASE_URL=postgresql://quickstart:quickstart@localhost:5433/quickstart
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
OPENSEARCH_URL=http://localhost:9200
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:9324

# Identity service (Slot 04) — use a long random secret in production (Secrets Manager)
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters-long!!
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
IDENTITY_PORT=3001
WORKSPACE_PORT=3002
GATEWAY_PORT=3000
IDENTITY_URL=http://127.0.0.1:3001
WORKSPACE_URL=http://127.0.0.1:3002
