meta {
  name: Create Knowledge Source (Enqueue Ingest)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/workspaces/{{workspaceId}}/knowledge/sources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt}}
}

body:json {
  {
    "name": "Company Refund Policy",
    "content": "Customers can request a full refund within 30 days of purchase with original receipt.",
    "type": "text"
  }
}
