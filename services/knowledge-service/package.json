{
  "name": "@quickstart/service-knowledge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "dev": "sh -c 'tsc -p tsconfig.json --watch & node --watch dist/index.js'",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/client-sqs": "^3.888.0",
    "@quickstart/auth": "workspace:*",
    "@quickstart/contracts": "workspace:*",
    "@quickstart/errors": "workspace:*",
    "@quickstart/http-server": "workspace:*",
    "@quickstart/logging": "workspace:*",
    "@quickstart/tracing": "workspace:*",
    "@quickstart/utilities": "workspace:*",
    "@quickstart/workspace-access": "workspace:*",
    "pg": "^8.16.3",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
