# Copy to .env.leads. Keep this file separate from the existing root .env.
# DEMO is explicitly simulated. Set live only after configuring real providers.
LEAD_GENERATION_MODE=demo
LEAD_GENERATION_HOST=127.0.0.1
LEAD_GENERATION_PORT=3019
LEAD_GENERATION_URL=http://127.0.0.1:3019
LEAD_GENERATION_ADMIN_TOKEN=replace-with-a-random-platform-admin-token
LEAD_WORKERS_ENABLED=true

# CRM handoff (Feature 24 lead-service)
LEAD_SERVICE_URL=http://127.0.0.1:3014
# LEAD_INTERNAL_TOKEN=   # defaults to INTERNAL_TOKEN from root .env

# Avoid the frontend/model gateway port collision.
MODEL_GATEWAY_PORT=3005
MODEL_GATEWAY_URL=http://127.0.0.1:3005
MODEL_GATEWAY_INTERNAL_TOKEN=replace-with-a-random-model-internal-token
WEB_FETCH_URL=http://127.0.0.1:3007
WEB_FETCH_INTERNAL_TOKEN=replace-with-a-random-web-internal-token

# Live mode: configure a profile already supported by model-gateway and an available model.
LEAD_MODEL_PROFILE=openai
LEAD_MODEL_ID=
# OPENAI_API_KEY / GROQ_API_KEY etc. belong to model-gateway, not public clients.

# Live acquisition: disable fake providers explicitly. Olostep requires OLOSTEP_API_KEY.
# These values are application estimates, not verified vendor prices.
ACQUISITION_PROVIDER_PROFILES_JSON=[{"id":"direct_http","driver":"direct_http","enabled":true,"priority":10,"unitCostMicrosScrape":0,"unitCostMicrosSearch":0},{"id":"olostep","driver":"olostep","enabled":true,"priority":20,"unitCostMicrosScrape":0,"unitCostMicrosSearch":0,"apiKeyEnv":"OLOSTEP_API_KEY"}]

# Campaign ingest (campaign-service internal route). Uses CAMPAIGN_INTERNAL_TOKEN / INTERNAL_TOKEN.
LEAD_CAMPAIGN_INGEST_URL=http://127.0.0.1:3013/internal/v1/campaigns/leads/ingest
LEAD_CAMPAIGN_TOKEN=dev-only-internal-token-min-32-chars-long!!!!!!

# Provider API Keys
# OLOSTEP_API_KEY=olostep_...
# FIRECRAWL_API_KEY=fc-...
# GROQ_API_KEY=gsk_...
# BLUEMINDS_API_KEY=sk-...
# BLUEMINDS_BASE_URL=https://api.bluesminds.com/v1

